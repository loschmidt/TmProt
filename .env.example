# Copy this file to .env and fill in your values. Never commit .env.

# Required for ESM3-MLP strategy
# Get token from: https://forge.evolutionaryscale.ai/apikeys
ESM3_API_TOKEN=your_token_here

# Required only if running with --mlflow flag (DagsHub experiment tracking)
MLFLOW_TRACKING_URI=https://dagshub.com/<your-username>/<your-repo>.mlflow
DAGSHUB_REPO_OWNER=<your-username>
DAGSHUB_REPO_NAME=<your-repo>
DAGSHUB_USER_TOKEN=<your-dagshub-token>
